//-----------------------------------------------------------------------------
// List Active Brushes.
//-----------------------------------------------------------------------------
function listAssignBrushes()
{
	// Clear Brush Assignments.
	comAssignBrushList.clear();
	
	// Compile Brush Lists.	
	for ( %n = 1; %n <= $maxBrushes; %n++ )
		comAssignBrushList.add( $brush[%n].name, %n );
		
	// Select Current Brush.
	comAssignBrushList.setSelected( $currentBrush );		
}


//-----------------------------------------------------------------------------
// Brush Assignment Selection.
//-----------------------------------------------------------------------------
function comAssignBrushList::onSelect( %this, %id, %text )
{
	// Set Brush Name.
	txtBrushTargetName.setValue( %text );
}

