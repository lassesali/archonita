//-----------------------------------------------------------------------------
// Initialise Src/Dst Blend Factors.
//-----------------------------------------------------------------------------
comTileEditorSrcBlend.add("ZERO", 0);
comTileEditorSrcBlend.add("ONE", 1);
comTileEditorSrcBlend.add("DST_COLOR", 2);
comTileEditorSrcBlend.add("ONE_MINUS_DST_COLOR", 3);
comTileEditorSrcBlend.add("SRC_ALPHA", 4);
comTileEditorSrcBlend.add("ONE_MINUS_SRC_ALPHA", 5);
comTileEditorSrcBlend.add("DST_ALPHA", 6);
comTileEditorSrcBlend.add("ONE_MINUS_DST_ALPHA", 7);
comTileEditorSrcBlend.add("SRC_ALPHA_SATURATE", 8);

comTileEditorDstBlend.add("ZERO", 0);
comTileEditorDstBlend.add("ONE", 1);
comTileEditorDstBlend.add("SRC_COLOR", 2);
comTileEditorDstBlend.add("ONE_MINUS_SRC_COLOR", 3);
comTileEditorDstBlend.add("SRC_ALPHA", 4);
comTileEditorDstBlend.add("ONE_MINUS_SRC_ALPHA", 5);
comTileEditorDstBlend.add("DST_ALPHA", 6);
comTileEditorDstBlend.add("ONE_MINUS_DST_ALPHA", 7);


//-----------------------------------------------------------------------------
// Set Blend Defaults.
//-----------------------------------------------------------------------------
function setTileEditorBlendDefaults()
{
	// Set Defaults.
	comTileEditorSrcBlend.setSelected( comTileEditorSrcBlend.findText("SRC_ALPHA") );
	comTileEditorDstBlend.setSelected( comTileEditorDstBlend.findText("ONE_MINUS_SRC_ALPHA") );
}


//-----------------------------------------------------------------------------
// Read Blend Values.
//-----------------------------------------------------------------------------
function readTileEditorBlendValues()
{
	// Get Current Tile Layer Object.
	%layerObj = $editorTileMap.getTileLayer( $activeTileLayer );
	
	// Check Object is valid.
	if ( !%layerObj )
		return;

	// Get Blend Status.
	%blendStatus =  %layerObj.getBlending();
		
	// Setup Blend Controls.
	chkTileEditorBlendEnable.setValue( getWord(%blendStatus,0) );
	txtTileEditorLayerColour.setText( %layerObj.getBlendColour() );
	comTileEditorSrcBlend.setSelected( comTileEditorSrcBlend.findText(getWord(%blendStatus,1)) );
	comTileEditorDstBlend.setSelected( comTileEditorDstBlend.findText(getWord(%blendStatus,2)) );
}


//-----------------------------------------------------------------------------
// Set the Tile Layer Blending.
//-----------------------------------------------------------------------------
function setTileEditorLayerBlending()
{
	// Get Current Tile Layer Object.
	%layerObj = $editorTileMap.getTileLayer( $activeTileLayer );
	
	// Check Object is valid.
	if ( !%layerObj )
		return;
		
	// Set Blending Options.
	%layerObj.setBlending( chkTileEditorBlendEnable.getValue(), comTileEditorSrcBlend.getText(), comTileEditorDstBlend.getText() );
	%layerObj.setBlendColour( txtTileEditorLayerColour.getValue() );
}


