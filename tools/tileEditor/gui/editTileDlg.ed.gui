//-----------------------------------------------------------------------------
// Dialog Wake.
//-----------------------------------------------------------------------------
function editTileDlg::onWake( %this )
{
	// Populate Prefab Collisions Polygons.
	populatePrefabCollisionPolygons();	
}


//-----------------------------------------------------------------------------
// Tile Custom Data Selection.
//-----------------------------------------------------------------------------
function comTileEditCustomData::onSelect( %this, %id, %text )
{
	// Set Custom Data.
	txtTileEditCustomData.setValue( %text );
}


//-----------------------------------------------------------------------------
// Tile Script Selection.
//-----------------------------------------------------------------------------
function comTileEditScriptData::onSelect( %this, %id, %text )
{
	// Set Script.
	txtTileEditScript.setValue( %text );
}


//-----------------------------------------------------------------------------
// Prefab Collision Polygons.
//-----------------------------------------------------------------------------
function populatePrefabCollisionPolygons()
{
	// Clear Polygon List.
	comTileEditPolyDefinition.clear();

	// Add Prefab Polygons.	
	comTileEditPolyDefinition.add("Full", 0);
	comTileEditPolyDefinition.add("Triangle (Top-Left)", 1);
	comTileEditPolyDefinition.add("Triangle (Top-Right)", 2);
	comTileEditPolyDefinition.add("Triangle (Bottom-Left)", 3);
	comTileEditPolyDefinition.add("Triangle (Bottom-Right)", 4);
	comTileEditPolyDefinition.add("Rectangle (Left-Half)", 5);
	comTileEditPolyDefinition.add("Rectangle (Right-Half)", 6);
	comTileEditPolyDefinition.add("Rectangle (Top-Half)", 7);
	comTileEditPolyDefinition.add("Rectangle (Bottom-Half)", 8);
	comTileEditPolyDefinition.add("Quadrant (Top-Left)", 9);
	comTileEditPolyDefinition.add("Quadrant (Top-Right)", 10);
	comTileEditPolyDefinition.add("Quadrant (Bottom-Left)", 11);
	comTileEditPolyDefinition.add("Quadrant (Bottom-Right)", 12);
	comTileEditPolyDefinition.add("Spike (Wide-Up)", 13);
	comTileEditPolyDefinition.add("Spike (Wide-Down)", 14);
	comTileEditPolyDefinition.add("Spike (Narrow-Up)", 15);
	comTileEditPolyDefinition.add("Spike (Narrow-Down)", 16);
	//comTileEditPolyDefinition.add("Circle (low-res)", 17);
	//comTileEditPolyDefinition.add("Circle (high-res)", 18);
	
	// Setup Polygon Definition Array.
	$tileEditPolyDef[0]		= "-1 -1 1 -1 1 1 -1 1";
	$tileEditPolyDef[1]		= "-1 -1 1 -1 -1 1";
	$tileEditPolyDef[2]		= "-1 -1 1 -1 1 1";
	$tileEditPolyDef[3]		= "1 1 -1 1 -1 -1";
	$tileEditPolyDef[4]		= "1 -1 1 1 -1 1";
	$tileEditPolyDef[5]		= "-1 -1 0 -1 0 1 -1 1";
	$tileEditPolyDef[6]		= "0 -1 1 -1 1 1 0 1";
	$tileEditPolyDef[7]		= "-1 -1 1 -1 1 0 -1 0";
	$tileEditPolyDef[8]		= "-1 0 1 0 1 1 -1 1";
	$tileEditPolyDef[9]		= "-1 -1 0 -1 0 0 -1 0";
	$tileEditPolyDef[10]	= "0 -1 1 -1 1 0 0 0";
	$tileEditPolyDef[11]	= "-1 0 0 0 0 1 -1 1";
	$tileEditPolyDef[12]	= "0 0 1 0 1 1 0 1";
	$tileEditPolyDef[13]	= "-1 1 0 -1 1 1";
	$tileEditPolyDef[14]	= "-1 -1 1 -1 0 1";
	$tileEditPolyDef[15]	= "-0.25 1 0 -1 0.25 1";
	$tileEditPolyDef[16]	= "-0.25 -1 0.25 -1 0 1";
	//$tileEditPolyDef[17]	= "0.707107 0.707107 0.258819 0.965926 -0.258819 0.965926 -0.707107 0.707107 -0.965926 0.258819 -0.965926 -0.258819 -0.707107 -0.707107 -0.258819 -0.965926 0.258819 -0.965926 0.707107 -0.707107 0.965926 -0.258819 0.965926 0.258819";
	//$tileEditPolyDef[18]	= "0.866025 0.500000 0.642788 0.766044 0.342020 0.939693 0.000000 1.000000 -0.342020 0.939693 -0.642788 0.766044 -0.866025 0.500000 -0.984808 0.173648 -0.984808 -0.173648 -0.866025 -0.500000 -0.642788 -0.766044 -0.342020 -0.939693 -0.000000 -1.000000 0.342020 -0.939693 0.642788 -0.766045 0.866025 -0.500000 0.984808 -0.173648 0.984808 0.173648";
}


//-----------------------------------------------------------------------------
// Tile Edit - Prefab Polygon Definitions.
//-----------------------------------------------------------------------------
function comTileEditPolyDefinition::onSelect( %this, %id, %text )
{
	// Fetch Polygon Definition.
	%polyDefinition = $tileEditPolyDef[%id];
	
	// Calculate Polygon Edge Count.
	%polyCount = getWordCount( %polyDefinition ) / 2;
	
	// Set Polygon Count.
	txtTileEditPolyCount.setValue( %polyCount );
	// Set Polygon Definition.
	txtTileEditPolyDefinition.setValue( $tileEditPolyDef[%id] );
}

