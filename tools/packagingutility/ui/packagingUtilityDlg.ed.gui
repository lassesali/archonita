function packagingUtilityDlg::onWake()
{
   %menu = packagingUtilityMenu;
   
   %menu.clearMenus();
   
   // File menu.
   %menu.addMenu("File", 0);
   %menu.addMenuItem("File", "Load...", 0);
   %menu.scriptCommand["File", 0] = "loadPackageFile();";
   %menu.addMenuItem("File", "Save...", 1);
   %menu.scriptCommand["File", 1] = "savePackageFile();";
   %menu.addMenuItem("File", "-", 2);
   %menu.addMenuItem("File", "Close", 3);
   %menu.scriptCommand["File", 3] = "cleanUpBuild();";
   
   // Package menu.
   %menu.addMenu("Package", 1);
   %menu.addMenuItem("Package", "Analyze", 0);
   %menu.scriptCommand["Package", 0] = "preAnalyzeBuild();";
   %menu.addMenuItem("Package", "Build", 1);
   %menu.scriptCommand["Package", 1] = "processUserBuildModification();";
   %menu.addMenuItem("Package", "-", 2);
   %menu.addMenuItem("Package", "Options...", 3);
   %menu.scriptCommand["Package", 3] = "configurePackagingOptions();";
   %menu.addMenuItem("Package", "Extensions...", 4);
   %menu.scriptCommand["Package", 4] = "configurePackagingExtensions();";
}

function packagingUtilityMenu::onMenuItemSelect(%this, %menuId, %menu, %itemId, %item)
{
   // Script-Command Available?
   if(%this.scriptCommand[%menu, %itemId] !$= "")
      // Yes, so execute it.
      eval(%this.scriptCommand[%menu, %itemId]);
   else
      // No, so error!
      error("No script command defined for menu " @ %menu  @ " item " @ %item);
}
