//--- OBJECT WRITE BEGIN ---
new GuiControl(ggSplash) {
   canSaveDynamicFields = "0";
   Profile = "GuiDefaultProfile";
   HorizSizing = "width";
   VertSizing = "height";
   position = "0 0";
   Extent = "1024 768";
   MinExtent = "8 2";
   canSave = "1";
   Visible = "1";
   done = "1";
};
//--- OBJECT WRITE END ---

function loadGGSplash()
{
   Canvas.setContent(ggSplash);
   schedule(100, 0, checkGGSplash);
}

function checkGGSplash()
{
   if (ggSplash.done)
      gamelonIntro();
   else
      schedule(100, 0, checkGGSplash);
}
